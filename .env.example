# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.

# Path to your YAML configuration file (optional, defaults to config.yaml)
# CONFIG_PATH=config.yaml

# OpenAI API key (required when using openai provider)
OPENAI_API_KEY=your-openai-api-key-here

# Override OpenAI API base URL (optional, useful for Azure OpenAI or other compatible APIs)
# OPENAI_API_BASE=https://api.openai.com/v1

# Override Ollama base URL (optional, defaults to http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434
